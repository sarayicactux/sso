
model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  email     String    @unique
  mobile    String    @unique @db.VarChar(11)
  firstName String?
  lastName  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  
  // Relations
  AdminTokens     AdminToken[]
  Logs           Log[]
  apps           App[]
  @@map("admins")
}
