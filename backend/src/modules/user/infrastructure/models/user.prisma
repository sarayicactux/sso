
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  email     String    @unique
  mobile    String    @unique @db.VarChar(11)
  firstName String?
  lastName  String?
  status    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  UserTokens UserToken[]
  UserApps   UserApp[]
  appUsers   AppUser[]

  @@map("users")
}
