model AppUser {
  id           Int       @id @default(autoincrement())
  userId       Int
  appId        Int
  access_token String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  User User @relation(fields: [userId], references: [id])
  App  App  @relation(fields: [appId], references: [id])

  @@unique([userId, appId])
  @@map("app_user")
}
